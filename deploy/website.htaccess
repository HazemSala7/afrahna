# Afrahna — public website (Next.js static export).
#
# IMPORTANT: on afrahna.co this file lives in /public_html, which is the parent
# of admin/ (the Laravel API), dashboard/, i/ and v/. Everything here is
# inherited by those directories, so this file stays deliberately minimal.
# Aggressive caching lives in _next/.htaccess, which only covers Next's
# content-hashed build output.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
      application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML filenames never change between builds, so they must revalidate or
  # visitors keep seeing the previous deploy. Scoped to .html only: the API and
  # the dashboard serve .php and are untouched by this.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
