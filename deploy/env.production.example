APP_NAME=Afrahna
APP_ENV=production
APP_KEY=base64:giwRyskIOvIe9y8/oTrTPTctPM/IcQaDG9B4lLk9W0k=
APP_DEBUG=false
APP_URL=https://afrahna.co/admin

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# === Fill these from cPanel -> MySQL Databases ===============================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_ME_db
DB_USERNAME=REPLACE_ME_user
DB_PASSWORD=REPLACE_ME_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# === Web deploy helper (used by public/deploy.php) ===========================
# Visit:  https://afrahna.co/admin/deploy.php?token=...&action=...
# Then DELETE public/deploy.php from the server immediately.
DEPLOY_TOKEN=r4bzdwhiyoenmtxsf8u652a93kc0gqlp1jv7

# === Mail (cPanel email) =====================================================
MAIL_MAILER=smtp
MAIL_HOST=mail.afrahna.co
MAIL_PORT=465
MAIL_USERNAME=noreply@afrahna.co
MAIL_PASSWORD=REPLACE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@afrahna.co"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=afrahna.co
SESSION_DOMAIN=.afrahna.co

# === Firebase Cloud Messaging (push notifications) ===========================
# Absolute path on the server to the service-account JSON downloaded from the
# Firebase console (Project settings → Service accounts → Generate new key).
# Upload it OUTSIDE the public web root and point this at it.
FIREBASE_CREDENTIALS=/home/REPLACE_ME/firebase/service-account.json
