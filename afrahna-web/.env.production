# The whole product is served from afrahna.co: the API and uploads under
# /admin, the dashboard under /dashboard, and the public website at the root.
# afrahna.ps is not usable yet — its registrar delegates to nameservers that
# refuse the zone, so it does not resolve and cannot be issued a certificate.
NEXT_PUBLIC_API_URL=https://afrahna.co/admin/api/v1
NEXT_PUBLIC_SITE_URL=https://afrahna.co
